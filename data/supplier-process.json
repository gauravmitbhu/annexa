    "roles": [
      {
        "role": "Procurement (Procurement partner)",
        "responsibilities": [
          "Handles contracting activities following final approval",
          "Ensures suppliers sign or align with the CoC",
          "Maintains the Approved Supplier List (ASL)",
          "Initiates evaluations in rating platform"
        ]
      },
      {
        "role": "CEO",
        "responsibilities": [
          "Evaluates escalated risks and findings (management escalation)"
        ]
      },
      {
        "role": "Compliance & IT Security Manager",
        "responsibilities": [
          "Oversees implementation of the process",
          "Assesses security, compliance and data-access risks, and initiates supplier evaluation if required"
        ]
      },
      {
        "role": "Supplier Owner (Managers)",
        "responsibilities": [
          "Classifies the supplier",
          "Performs the supplier risk assessment",
          "Initial and annual evaluation of the supplier"
        ]
      },
      {
        "role": "Supplier engagement requester (Manager)",
        "responsibilities": [
          "Initiates the supplier engagement request and provides the required information"
        ]
      }
    ],
