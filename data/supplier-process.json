      "author": "Priya Shah",
      "owner": "Priya Shah",
      "approvedBy": "Jordan Blake",
      "location": "Processes › Approved (ISMS library)",
      "purpose": "Defines the steps for initiating, reviewing, approving, contracting and evaluating suppliers, to ensure appropriate business, financial and security oversight before and during engagement.",
      "scope": "All suppliers whose products or services impact information security or data protection; environmental performance or sustainability; health, safety or human rights; or business continuity and operational resilience.",
      "granularity": "Followed in full for new contracts and renewals. For existing suppliers, evaluation and monitoring are implemented and the additional requirements are proposed to the supplier on a voluntary basis.",
      "criticalDefinition": "Critical suppliers are those whose compromised delivery of service or goods would directly affect Northwind's ability to deliver services under customer contracts — i.e. would breach an SLA.",
      "references": [
        "ISO 27001 — A.5.19 to A.5.23 (supplier relationship management)",
        "ISO 14001 — 8.1 (operational control)",
        "ISO 9001 — 7.1, 8.4, 8.5, 9.1.3",
        "Supplier Code of Conduct (CoC)",
        "rating platform platform guidance",
        "Risk Assessment and Statement of Applicability"
      ],
