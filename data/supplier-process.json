  "SUPPLIER_PROCESS": {
    "note": "Demo data. Transcribed from the Northwind Ltd Supplier Management Process v2.0 and its two BPMN diagrams (Supplier Engagement, Supplier Evaluation). Anything not stated in the document is marked inferred.",
    "doc": {
      "title": "Suppliers' classification & evaluation process",
      "reference": "Supplier_Evaluation_Process",
      "file": "Supplier_Management_Process_v2.0.docx",
