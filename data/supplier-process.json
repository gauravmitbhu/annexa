    "contracting": {
      "title": "Contracting",
      "owner": "Supplier Owner",
      "note": "Section VII of the process, with its own diagram (Supplier Contracting.png). Rendered as a checklist rather than a swimlane because every step is a yes/no inclusion decision by a single role.",
      "steps": [
        {
          "gate": "Legal or environmental requirements?",
          "then": "The environmental and legal requirements are included in the contract."
        },
        {
          "gate": "Confidentiality required?",
          "then": "Confidentiality is included in the contract or an NDA is signed, and Procurement system is updated.",
          "tool": "Procurement system"
        },
        {
          "gate": "Security requirements?",
          "then": "The security requirements are included in the contract."
        },
        {
          "gate": "Security procedure required?",
          "then": "The security procedure is provided to the supplier."
        },
        {
          "gate": "",
          "then": "The contract is stored on the document library."
        }
      ]
